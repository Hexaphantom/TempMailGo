# TempMailGo environment configuration (all OPTIONAL — the app runs with none set)
# Copy to .env for local dev if you want to override defaults.

# Port the app listens on (Render sets this automatically).
PORT=3000

# --- mail.tm client tuning (optional) ---
# Base URL of the mail.tm API.
MAILTM_BASE=https://api.mail.tm
# Minimum spacing between outbound mail.tm requests, in ms (throttle to stay
# under mail.tm's 8 QPS-per-IP limit). Default 160ms (~6 req/s). Raise this if
# you see 429s under heavy traffic.
MAILTM_MIN_SPACING_MS=160

# --- Guerrilla Mail client tuning (optional) ---
# Base URL of the Guerrilla Mail JSON API. No key or signup needed.
GUERRILLA_BASE=https://api.guerrillamail.com/ajax.php

# --- Mailinator client tuning (optional) ---
# Base URL of the Mailinator public API. No key or signup needed.
MAILINATOR_BASE=https://api.mailinator.com
# Min spacing between Mailinator requests, in ms (its public API rate-limits
# rapid calls from a shared IP and will return an HTML page). Default 1200ms.
MAILINATOR_MIN_SPACING_MS=1200

# --- DropMail client tuning (optional) ---
# Base URL of the DropMail API. No signup needed, but a signed af_ token is
# generated automatically (POST /api/token/generate) and REUSED across sessions.
DROPMAIL_BASE=https://dropmail.me/api
# Token lifetime: 1h or 1d need NO captcha; longer values require a captcha and
# will fail from a server. Keep this at 1h or 1d. Default 1h.
DROPMAIL_LIFETIME=1h
